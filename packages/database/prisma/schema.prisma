generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  APPROVER
  EDITOR_LEAD
  EDITOR
  OFFICER
  CITIZEN
  ENTERPRISE
}

enum PostStatus {
  DRAFT
  SUBMITTED
  IN_EDITING
  PENDING_REVIEW
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
  REJECTED
  ARCHIVED
}

enum SubmissionStatus {
  TIEP_NHAN
  DANG_XU_LY
  THAM_DINH
  YEU_CAU_BO_SUNG
  HOAN_TAT
  TU_CHOI
}

model User {
  id               String          @id @default(uuid())
  username         String          @unique
  email            String          @unique
  passwordHash     String          @map("password_hash")
  fullName         String          @map("full_name")
  role             Role            @default(CITIZEN)
  roleDefinitionId String?         @map("role_definition_id")
  roleDefinition   RoleDefinition? @relation(fields: [roleDefinitionId], references: [id])
  department       String?
  avatarUrl        String?         @map("avatar_url")
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  posts            Post[]
  auditLogs        AuditLog[]
  notifications    Notification[]

  @@map("users")
}

model RoleDefinition {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  badgeClass  String?  @default("bg-slate-800 text-slate-300 border-slate-700") @map("badge_class")
  isSystem    Boolean  @default(false) @map("is_system")
  permissions String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  users       User[]

  @@map("role_definitions")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  posts     Post[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("categories")
}

model Post {
  id                 String            @id @default(uuid())
  slug               String            @unique
  title              String
  summary            String
  content            String            @db.Text
  categoryId         String            @map("category_id")
  category           Category          @relation(fields: [categoryId], references: [id])
  authorId           String            @map("author_id")
  author             User              @relation(fields: [authorId], references: [id])
  assignedToId       String?           @map("assigned_to_id")
  assignedToName     String?           @map("assigned_to_name")
  currentStep        Int               @default(1) @map("current_step")
  scheduledPublishAt DateTime?         @map("scheduled_publish_at")
  views              Int               @default(0)
  imageUrl           String            @map("image_url")
  imageCaption       String?           @map("image_caption")
  isFeatured         Boolean           @default(false) @map("is_featured")
  isSpotlight        Boolean           @default(false) @map("is_spotlight")
  tags               String[]
  status             PostStatus        @default(DRAFT)
  isSafetyCommitted  Boolean           @default(false) @map("is_safety_committed")
  attachments        String[]          @default([])
  royaltyScore       Int?              @map("royalty_score")
  royaltyNotes       String?           @map("royalty_notes")
  approvalNotes      String?           @map("approval_notes")
  scoredById         String?           @map("scored_by_id")
  scoredByName       String?           @map("scored_by_name")
  scoredAt           DateTime?         @map("scored_at")
  unpublishReason    String?           @map("unpublish_reason")
  unpublishedAt      DateTime?         @map("unpublished_at")
  unpublishedById    String?           @map("unpublished_by_id")
  rejectionReason    String?           @map("rejection_reason")
  publishedAt        DateTime?         @map("published_at")
  metaTitle          String?           @map("meta_title")
  metaDescription    String?           @map("meta_description")
  isDeleted          Boolean           @default(false) @map("is_deleted")
  deletedAt          DateTime?         @map("deleted_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  history            PostHistory[]
  workflowLogs       PostWorkflowLog[]

  @@map("posts")
}

model PostWorkflowLog {
  id             String   @id @default(uuid())
  postId         String   @map("post_id")
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  step           Int
  stepName       String   @map("step_name")
  action         String
  actorId        String   @map("actor_id")
  actorName      String   @map("actor_name")
  actorRole      String?  @map("actor_role")
  assignedToId   String?  @map("assigned_to_id")
  assignedToName String?  @map("assigned_to_name")
  note           String?  @db.Text
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("post_workflow_logs")
}

model PostHistory {
  id          String   @id @default(uuid())
  postId      String   @map("post_id")
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  version     Int
  title       String
  summary     String
  content     String   @db.Text
  updatedById String   @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("post_histories")
}

model LegalDocument {
  id                    String    @id @default(uuid())
  code                  String    @unique
  title                 String
  docType               String    @map("doc_type")
  issuingAgency         String    @map("issuing_agency")
  signer                String
  issueDate             DateTime  @map("issue_date")
  effectiveDate         DateTime  @map("effective_date")
  expirationDate        DateTime? @map("expiration_date")
  status                String
  approvalStatus        String    @default("PUBLISHED") @map("approval_status")
  domain                String
  fileSize              String    @map("file_size")
  fileUrl               String?   @map("file_url")
  p7sSignatureUrl       String?   @map("p7s_signature_url")
  htmlContent           String?   @db.Text @map("html_content")
  attachments           String[]  @default([])
  isConfidentialChecked Boolean   @default(true) @map("is_confidential_checked")
  authorId              String?   @map("author_id")
  approverId            String?   @map("approver_id")
  rejectionReason       String?   @db.Text @map("rejection_reason")
  downloadsCount        Int       @default(0) @map("downloads_count")
  viewsCount            Int       @default(0) @map("views_count")
  fullText              String    @db.Text @map("full_text")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("legal_documents")
}

model PublicServiceSubmission {
  id              String           @id @default(uuid())
  trackingCode    String           @unique @map("tracking_code")
  serviceName     String           @map("service_name")
  applicantName   String           @map("applicant_name")
  applicantPhone  String           @map("applicant_phone")
  applicantEmail  String           @map("applicant_email")
  submissionDate  DateTime         @default(now()) @map("submission_date")
  expectedDate    DateTime         @map("expected_date")
  currentStep     Int              @default(1) @map("current_step")
  status          SubmissionStatus @default(TIEP_NHAN)
  statusText      String           @map("status_text")
  assignedOfficer String?          @map("assigned_officer")
  department      String
  formData        String?          @db.Text @map("form_data")
  notes           String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("public_service_submissions")
}

model EnvironmentalFeedback {
  id                 String   @id @default(uuid())
  ticketCode         String   @unique @map("ticket_code")
  title              String
  senderName         String   @map("sender_name")
  senderPhone        String   @map("sender_phone")
  senderEmail        String?  @map("sender_email")
  facility           String?  @map("facility")
  category           String?  @map("category")
  timeOccurrence     String?  @map("time_occurrence")
  location           String?  @db.Text
  content            String?  @db.Text
  photoUrl           String?  @map("photo_url") @db.Text
  status             String   @default("da-tiep-nhan")
  statusText         String?  @map("status_text") @db.Text
  assignedOfficer    String?  @map("assigned_officer")
  assignedDepartment String?  @map("assigned_department")
  currentStep        Int      @default(1) @map("current_step")
  officialResponse   String?  @map("official_response") @db.Text
  isPublic           Boolean  @default(false) @map("is_public")
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("environmental_feedbacks")
}

model Inquiry {
  id           String    @id @default(uuid())
  title        String
  content      String    @db.Text
  fullName     String    @map("full_name")
  email        String
  phone        String
  latitude     Float?
  longitude    Float?
  attachments  String[]
  replyContent String?   @db.Text @map("reply_content")
  repliedBy    String?   @map("replied_by")
  repliedAt    DateTime? @map("replied_at")
  isPublic     Boolean   @default(false) @map("is_public")
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("inquiries")
}

model Faq {
  id          String   @id @default(uuid())
  question    String
  answer      String   @db.Text
  category    String
  order       Int      @default(0)
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("faqs")
}

model Form {
  id          String   @id @default(uuid())
  code        String   @unique
  title       String
  description String?
  schemaJson  String   @db.Text @map("schema_json")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("forms")
}

model Poll {
  id          String     @id @default(uuid())
  title       String
  description String?
  options     String     @db.Text
  startDate   DateTime   @map("start_date")
  endDate     DateTime   @map("end_date")
  isActive    Boolean    @default(true) @map("is_active")
  votesCount  Int        @default(0) @map("votes_count")
  createdAt   DateTime   @default(now()) @map("created_at")
  votes       PollVote[]

  @@map("polls")
}

model PollVote {
  id          String   @id @default(uuid())
  pollId      String   @map("poll_id")
  poll        Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionIndex Int      @map("option_index")
  ipAddress   String   @map("ip_address")
  userId      String?  @map("user_id")
  votedAt     DateTime @default(now()) @map("voted_at")

  @@map("poll_votes")
}

model WeeklySchedule {
  id          String   @id @default(uuid())
  weekNumber  Int      @map("week_number")
  year        Int
  startDate   DateTime @default(now()) @map("start_date")
  endDate     DateTime @default(now()) @map("end_date")
  dayOfWeek   String   @map("day_of_week")
  date        DateTime
  timeSlot    String   @map("time_slot")
  isAllDay    Boolean  @default(false) @map("is_all_day")
  eventTitle  String   @map("event_title") @db.Text
  leaderName  String?  @map("leader_name")
  location    String?  @db.Text
  attendees   String?  @db.Text
  notes       String?  @db.Text
  isPublic    Boolean  @default(true) @map("is_public")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([year, weekNumber])
  @@map("weekly_schedules")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  module    String
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  ipAddress String?  @map("ip_address")
  details   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model StaticPage {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  summary         String?  @db.Text
  content         String   @db.Text
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  isHidden        Boolean  @default(false) @map("is_hidden")
  updatedById     String?  @map("updated_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("static_pages")
}

model Media {
  id            String   @id @default(uuid())
  title         String?
  description   String?  @db.Text
  category      String?  @default("Khu Đa Phước")
  caption       String?
  isFeatured    Boolean  @default(false) @map("is_featured")
  tags          String[]
  originalName  String   @map("original_name")
  filename      String   @unique
  mimeType      String   @map("mime_type")
  size          Int
  width         Int?
  height        Int?
  url           String
  relativeUrl   String   @map("relative_url")
  storageDriver String   @default("local") @map("storage_driver")
  uploadedById  String?  @map("uploaded_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("media")
}

model MediaCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("media_categories")
}

enum BackupTriggerType {
  AUTO_UPDATE
  SCHEDULED
  MANUAL
}

model SystemBackup {
  id          String            @id @default(uuid())
  filename    String            @unique
  filepath    String
  fileSize    Int               @map("file_size")
  triggerType BackupTriggerType @default(MANUAL) @map("trigger_type")
  description String?           @db.Text
  checksum    String
  recordCount Int               @default(0) @map("record_count")
  status      String            @default("SUCCESS")
  createdById String?           @map("created_by_id")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@map("system_backups")
}

enum NotificationType {
  TASK_ASSIGNED
  POST_APPROVED
  POST_REJECTED
  ROLE_UPDATED
  SUBMISSION_NEW
  SYSTEM_ALERT
}

model Notification {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType @default(SYSTEM_ALERT)
  title       String
  content     String           @db.Text
  linkUrl     String?          @map("link_url")
  isRead      Boolean          @default(false) @map("is_read")
  isEmailSent Boolean          @default(false) @map("is_email_sent")
  metadata    Json?
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}





