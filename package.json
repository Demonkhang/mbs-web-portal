{
  "name": "mbs-portal-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=@mbs/web",
    "dev:api": "npm run dev --workspace=@mbs/api",
    "dev:all": "turbo run dev || npm run dev --workspaces",
    "build": "vite build",
    "build:vercel": "prisma generate --schema=packages/database/prisma/schema.prisma && vite build",
    "build:all": "turbo run build || npm run build --workspaces",
    "db:push": "prisma db push --schema=packages/database/prisma/schema.prisma",
    "db:seed": "tsx scratch/seed-postgres.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "esbuild": "^0.25.0",
    "prisma": "^6.4.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "turbo": "^2.4.4",
    "typescript": "~5.8.2"
  }
}
