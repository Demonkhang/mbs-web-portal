{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@mbs/types": ["../../packages/types/src"],
      "@mbs/validation": ["../../packages/validation/src"],
      "@mbs/security-utils": ["../../packages/security-utils/src"],
      "@mbs/database": ["../../packages/database/src"]
    }
  },
  "include": ["src/**/*"]
}
